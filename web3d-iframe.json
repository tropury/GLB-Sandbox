  "code": 200,
  "data": {
    "description": "Visualizador 3d Online",
    "external": {},
    "html": "<html lang=\"pt-BR\"><head>\n\n<title>WebGl</title>\n\n<meta charset=\"utf-8\">\n<meta name=\"description\" content=\"Visualizador 3d Online\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n<!-- =====================================================\nMOBILE FULLSCREEN\n====================================================== -->\n\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n\n  <style>\n\n    /* =====================================================\n       CONFIGURAÇÃO GERAL PAGINA\n    ====================================================== */\n\n    html, body {\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n    background: #f2f2f2;\n    font-family: Arial, sans-serif;\n    touch-action: manipulation;\n    }\n\n    body{\n    position: fixed;\n    inset: 0;\n    }\n\n    /* =====================================================\n       DARK THEME\n    ====================================================== */\n\n    body.dark-theme{\n    background:#212425;\n    }\n\n    body.dark-theme model-viewer{\n    background:#212425;\n    }\n\n    body.dark-theme .texture-title{\n    color:#f2f2f2;\n    }\n\n    body.dark-theme .mouse-item span{\n    color:#f2f2f2;\n    }\n\n    body.dark-theme .texture-bar{\n    background:rgba(40,40,40,0.35);\n    }\n\n    body.dark-theme #ar-prompt-btn{\n    background-color:rgba(255,255,255,0.08);\n    }\n     \n    #themeBtn{\n    position:absolute;\n    top:30px;\n    right:35px;\n\n    width:40px;\n    height:40px;\n\n    border:none;\n    border-radius:12px;\n\n    background:rgba(255, 255, 255, 0);\n    backdrop-filter:blur(8px);\n\n    cursor:pointer;\n    z-index:999;\n    }\n\n    body,\n    model-viewer,\n    .texture-title,\n    .texture-bar{\n    transition: 0.85s ease;\n    }\n\n    /* =====================================================\n       CONTAINER VIEWER\n    ====================================================== */\n\n    .viewer-container{\n    position: fixed;\n    inset: 0;\n    overflow: hidden;\n  \n    }\n\n   /* =====================================================\n   BOTÃO AR\n   ====================================================== */\n\n   #ar-prompt-btn{\n   position: absolute;\n\n   top: 20px;\n   left: 20px;\n\n   z-index: 20;\n\n   width: 42px;\n   height: 42px;\n\n   background-image: url(\"https://static.wixstatic.com/media/018800_0b70829029e147aea0d04adc92a85e7e~mv2.png\");\n   background-size: contain;\n   background-repeat: no-repeat;\n   background-position: center;\n\n   background-color: rgba(255,255,255,0.15);\n   backdrop-filter: blur(8px);\n\n   border: none;\n   border-radius: 12px;\n\n   cursor: pointer;\n   }\n\n    /* =====================================================\n       MODEL VIEWER\n    ====================================================== */\n\n    model-viewer {\n    width: 100%;\n    height: 100%;    \n    display: block;\n    background: #f2f2f2;   \n    }\n\n    /* =====================================================\n       DOF FAKE\n    ====================================================== */\n\n    .viewer-container::before{\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    backdrop-filter: blur(1.5px);\n\n    mask-image:\n    radial-gradient(\n    circle at center,\n    transparent 20%,\n    rgba(0, 0, 0, 0) 55%,\n    rgba(0, 0, 0, 0) 100%\n    );\n\n    -webkit-mask-image:\n    radial-gradient(\n    circle at center,\n    transparent 20%,\n    rgba(0, 0, 0, 0) 55%,\n    rgba(0, 0, 0, 0) 100%\n    );\n\n    z-index: 2;\n    }\n\n    /* =====================================================\n       VINHETA\n    ====================================================== */\n\n    .viewer-container::after{\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n\n    background:\n    radial-gradient(\n    circle at center,\n    transparent 45%,\n    rgba(0, 0, 0, 0) 100%\n    );\n\n    z-index: 3;\n    }\n\n    /* =====================================================\n       CONTAINER DAS BARRAS\n    ====================================================== */\n\n    .texture-wrapper{\n    position: fixed;\n\n    bottom:\n    max(20px, env(safe-area-inset-bottom));\n    left: 50%;\n    transform: translateX(-50%);\n    display: flex;\n    gap: 10px;\n\n    z-index: 10;\n    flex-wrap: wrap;\n    justify-content: center;\n    padding-inline: 0px;\n    }\n\n    /* =====================================================\n       BLOCO DE CADA BARRA - CELULA\n    ====================================================== */\n\n    .texture-group{\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 1px;\n    }\n\n    /* =====================================================\n       TITULO BARRA\n    ====================================================== */\n\n    .texture-title{\n    font-size: 13px;\n    font-weight: bold;\n    color: #2a2a2a;\n    }\n\n    /* =====================================================\n       BARRA TEXTURAS\n    ====================================================== */\n\n    .texture-bar {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n\n    padding: 5px;\n    background: rgba(255,255,255,0.26);\n    border-radius: 8px;\n    backdrop-filter: blur(3px);\n    box-shadow:\n    0 5px 20px rgba(0, 0, 0, 0);\n    }\n\n    /* =====================================================\n       THUMBS - MINIATURAS\n    ====================================================== */\n\n    .texture-thumb {\n    width: 40px;\n    height: 40px;\n\n    object-fit: cover;\n    border-radius: 12px;\n    cursor: pointer;\n    border: 2px solid transparent;\n    transition: 0.25s;\n    }\n\n    /* =====================================================\n       HOVER - MOUSE\n    ====================================================== */\n\n    .texture-thumb:hover{\n    transform: scale(1.06);\n    border-color: #4a4a4ac8;\n    }\n\n    /* =====================================================\n       MOBILE\n    ====================================================== */\n\n    @media (max-width: 768px){\n\n    .texture-bar{\n    gap: 6px;\n    padding: 6px 8px;\n    max-width: 88vw;\n    }\n\n    .texture-thumb{\n    width: 34px;\n    height: 34px;\n    border-radius: 10px;\n    }\n\n    .texture-group{\n    gap: 6px;\n    }\n\n    .texture-title{\n    font-size: 10px;\n    }\n\n    }\n\n    /* =====================================================\n   AJUDA MOUSE\n====================================================== */\n\n.mouse-help{\nposition: absolute;\n\ntop: 70px;\nright: 20px;\n\nz-index: 20;\n\ndisplay: flex;\nflex-direction: column;\ngap: 10px;\n\npadding: 10px;\n\nbackground: rgba(255, 255, 255, 0);\nbackdrop-filter: blur(8px);\n\nborder-radius: 14px;\n\nbox-shadow:\n0 4px 18px rgba(0, 0, 0, 0);\n}\n\n/* ITEM */\n\n.mouse-item{\ndisplay: flex;\nalign-items: center;\ngap: 10px;\n\nopacity: 1.72;\ntransition: 0.25s;\n}\n\n.mouse-item:hover{\nopacity: 1;\ntransform: translateX(-2px);\n}\n\n/* ICONE */\n\n.mouse-item img{\nwidth: 35px;\nheight: 35px;\n\nobject-fit: contain;\n}\n\n/* TEXTO */\n\n.mouse-item span{\nfont-size: 12px;\ncolor: #2d2d2d;\nfont-weight: 500;\nwhite-space: nowrap;\n}\n\n/* MOBILE */\n\n@media (max-width: 768px){\n\n.mouse-help{\ndisplay: none;\n}\n\n}\n\n/* =====================================================\n BOTÃO AR\n====================================================== */\n\n#ar-prompt-btn{\nposition: absolute;\n\nright: 20px;\nTop: 20px;\n\nwidth: 35px;\nheight: 35px;\n\nbackground-image: url(\"https://static.wixstatic.com/media/018800_0b70829029e147aea0d04adc92a85e7e~mv2.png\");\nbackground-size: contain;\nbackground-repeat: no-repeat;\nbackground-position: center;\n\nborder: none;\nbackground-color: transparent;\ncursor: pointer;\n\nz-index: 20;\n}\nbody{\nbackground:#f2f2f2;\nbackground-size:cover;\nbackground-position:center;\n}\n\n</style>\n\n</head>\n\n<body>\n\n<div class=\"mouse-help\">\n\n<div class=\"mouse-item\" id=\"themeToggle\">\n<img id=\"themeIcon\" src=\"https://static.wixstatic.com/media/472fb0_df44d9bd30f54dd89ed3e4991b1c4470~mv2.png\">\n</div>\n\n<div class=\"mouse-item\">\n<img src=\"https://static.wixstatic.com/media/472fb0_3f5de9e027e24c28b31acfe478eec3ea~mv2.png\">\n\n</div>\n\n<div class=\"mouse-item\">\n<img src=\"https://static.wixstatic.com/media/472fb0_9e65c443bd0941749dbadc8779ca0d5f~mv2.png\">\n\n</div>\n\n<div class=\"mouse-item\">\n<img src=\"https://static.wixstatic.com/media/472fb0_621eabbbd11343bc907b715d440e47a1~mv2.png\">\n\n</div>\n\n</div>\n\n\n<!-- =====================================================\n   ENGINE GLB \n====================================================== -->\n\n<model-viewer id=\"model\" src=\"https://static.wixstatic.com/3d/472fb0_9d0a97099bb347cb8b8cb8fda59e8584.glb\" ar=\"\" ar-modes=\"webxr scene-viewer quick-look\" camera-controls=\"\" interaction-prompt=\"none\" loading=\"eager\" reveal=\"auto\" tone-mapping=\"commerce\" environment-image=\"https://raw.githubusercontent.com/Vinametal/Assets3d/main/Galpao.hdr\" exposure=\"2.5\" shadow-intensity=\"1.2\" shadow-softness=\"0.95\" field-of-view=\"18deg\" min-camera-orbit=\"auto 0deg 3.0m\" max-camera-orbit=\"auto 88deg auto\" min-field-of-view=\"6deg\" camera-orbit=\"30.34deg 80.89deg 3.32m\" camera-target=\"0m 0.35m 0m\">\n\n<button slot=\"ar-button\" id=\"ar-prompt-btn\">\n</button>\n\n</model-viewer>\n\n\n\n\n\n\n\n\n\n<!-- =====================================================\n   CONTAINER\n====================================================== -->\n\n<div class=\"texture-wrapper\">\n\n<!-- =====================================================\n   TECIDOS\n====================================================== -->\n\n<div class=\"texture-group\">\n\n<div class=\"texture-title\">\nEstofado\n</div>\n\n<div class=\"texture-bar\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_5896f15d8ef946c8a2ae8cd8494b28ac~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_5896f15d8ef946c8a2ae8cd8494b28ac~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_5e4d84be92b94d908201223550bc25d0~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_5e4d84be92b94d908201223550bc25d0~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_81882df12cb244149730fbab2dd4bbbd~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_81882df12cb244149730fbab2dd4bbbd~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_c6be08702cab473c832e1703424b7960~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_c6be08702cab473c832e1703424b7960~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_63c61d54435b46c3a241c637145ab72b~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_63c61d54435b46c3a241c637145ab72b~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_e6f23c01489745e5bc3711bfc19b2852~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_e6f23c01489745e5bc3711bfc19b2852~mv2.jpg',\n'Fabric_mtl',\n0.75,\n0.0\n)\">\n\n\n</div>\n</div>\n\n<!-- =====================================================\n   CADEIRA\n====================================================== -->\n\n<div class=\"texture-group\">\n\n<div class=\"texture-title\">\nCadeira\n</div>\n\n<div class=\"texture-bar\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_281fd60198b743da9b7ebb1bb29d95e5~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_281fd60198b743da9b7ebb1bb29d95e5~mv2.jpg',\n'Legs_mtl',\n0.3,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_b6cfb567a0c64d0c8996f21c0bdf4700~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_b6cfb567a0c64d0c8996f21c0bdf4700~mv2.jpg',\n'Legs_mtl',\n0.25,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_cf35d2f5a6e64693a993b95c5c55b80f~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_cf35d2f5a6e64693a993b95c5c55b80f~mv2.jpg',\n'Legs_mtl',\n0.35,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_42b72e894e434e6fb7032172b4f50d3e~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_42b72e894e434e6fb7032172b4f50d3e~mv2.jpg',\n'Legs_mtl',\n0.3,\n0.0\n)\">\n\n<img class=\"texture-thumb\" src=\"https://static.wixstatic.com/media/472fb0_3e86adf310a84863b4563d08307a3bf5~mv2.jpg\" onclick=\"changeTexture(\n'https://static.wixstatic.com/media/472fb0_3e86adf310a84863b4563d08307a3bf5~mv2.jpg',\n'Legs_mtl',\n0.0,\n1.0\n)\">\n\n\n</div>\n</div>\n</div>\n\n<!-- =====================================================\n    SCRIPT\n====================================================== -->\n\n<script type=\"module\">\n\nconst modelViewer =\ndocument.querySelector(\"#model\");\n\n/* =====================================================\n   TROCA TEXTURA\n====================================================== */\n\nwindow.changeTexture = async function(\ntextureURL,\ntargetMaterialName,\nroughnessValue,\nmetallicValue\n){\n\nawait modelViewer.updateComplete;\n\nconst model = modelViewer.model;\n\nconst texture =\nawait modelViewer.createTexture(textureURL);\n\nconst material =\nmodel.materials.find(\nm => m.name === targetMaterialName\n);\n\nif (!material) {\n\nconsole.warn(\n\"Material não encontrado:\",\ntargetMaterialName\n);\n\nreturn;\n}\n\nif (\nmaterial.pbrMetallicRoughness\n.baseColorTexture\n) {\n\nmaterial.pbrMetallicRoughness\n.baseColorTexture\n.setTexture(texture);\n\nmaterial.pbrMetallicRoughness\n.setRoughnessFactor(roughnessValue);\n\nmaterial.pbrMetallicRoughness\n.setMetallicFactor(metallicValue);\n}\n\n};\n\nconst themeBtn = document.getElementById(\"themeToggle\");\nconst themeIcon = document.getElementById(\"themeIcon\");\n\nthemeBtn.addEventListener(\"click\", () => {\ndocument.body.classList.toggle(\"dark-theme\");\n\nconst dark =\ndocument.body.classList.contains(\"dark-theme\");\n\nthemeIcon.src =\ndark ? \"https://static.wixstatic.com/media/472fb0_c1e61add065f4a529761f90c39778054~mv2.png\" : \"https://static.wixstatic.com/media/472fb0_df44d9bd30f54dd89ed3e4991b1c4470~mv2.png\";\n});\n\n</script>\n\n<script type=\"module\" src=\"https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js\">\n</script>\n\n\n\n</body></html>",
